{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Furx Companion",
  "version": "0.1.0",
  "identifier": "cloud.furx.companion",
  "build": {
    "frontendDist": "../../pwa"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Furx",
        "width": 420,
        "height": 880,
        "resizable": true,
        "fullscreen": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "copyright": "© 2026 INVERSO HUB S.R.L.",
    "shortDescription": "Furx mobile companion",
    "longDescription": "Pairs with the Furx desktop over a local WebSocket bridge (loopback / Tailscale) to view panes, send voice/text commands, approve tool-calls, and receive notifications. BYOK: no provider keys on the phone.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "developmentTeam": "",
      "minimumSystemVersion": "14.0"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
