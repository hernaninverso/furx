# 022 US13 · L4 — workflow GHA de REFERENCIA para el e2e con tauri-driver (CI Linux).
# ──────────────────────────────────────────────────────────────────────────
# Es un EJEMPLO (extensión .example → no se activa solo). Copiar a
# .github/workflows/e2e-linux.yml cuando se habilite L4 en CI. NO usa Playwright:
# tauri-driver envuelve WebKitWebDriver (WebKitGTK) y WebdriverIO maneja la sesión.
#
# Pirámide completa que CI debería correr (ver docs/testing.md):
#   L1 (lógica)      → `npm test`            (node >=23.6, type-strip)  — macOS o Linux
#   L2 (componentes) → `npm run test:components` (vitest+jsdom+RTL)     — macOS o Linux
#   L3 (a11y)        → `npm run test:a11y`   (vitest-axe)               — macOS o Linux
#   L4 (e2e)         → `npm run test:e2e`    (tauri-driver)             — SÓLO Linux (este workflow)

name: e2e-linux

on:
  workflow_dispatch: {}        # manual por ahora (el binario release tarda en CI)
  # pull_request:               # descomentar para correrlo en cada PR

permissions:
  contents: read

jobs:
  e2e:
    runs-on: ubuntu-22.04
    steps:
      - uses: actions/checkout@v4

      - name: Setup Node (>=23.6 para type-strip de L1)
        uses: actions/setup-node@v4
        with:
          node-version: "23"
          cache: "npm"

      - name: Setup Rust
        uses: dtolnay/rust-toolchain@stable

      - name: Cache Rust
        uses: Swatinem/rust-cache@v2
        with:
          workspaces: "./src-tauri -> target"

      - name: Linux deps (WebKitGTK + WebDriver del WebView)
        run: |
          sudo apt-get update
          sudo apt-get install -y \
            libwebkit2gtk-4.1-dev libgtk-3-dev librsvg2-dev patchelf libssl-dev \
            webkit2gtk-driver xvfb

      - name: Install npm
        run: npm ci --no-audit --no-fund --legacy-peer-deps

      # L1 + L2 + L3 (rápidos, sin GUI).
      - name: L1 lógica
        run: npm test
      - name: L2 componentes + L3 a11y
        run: npm run test:components

      # L4: build release + tauri-driver bajo display virtual.
      - name: Install tauri-driver
        run: cargo install tauri-driver --locked
      - name: Build app (release)
        run: npm run tauri build
      - name: L4 e2e (tauri-driver)
        run: xvfb-run -a npm run test:e2e
